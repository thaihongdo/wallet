# HTTP
PORT=8080
GIN_MODE=release
SHUTDOWN_TIMEOUT=10s

# Postgres (local compose default)
DATABASE_URL=postgres://wallet:wallet@localhost:5432/wallet?sslmode=disable
DB_MAX_CONNS=5

# Redis (local compose default)
REDIS_URL=redis://localhost:6379/0

# Auth: comma-separated API keys accepted in the X-API-Key header
API_KEYS=local-dev-key

# Rate limiting
RATE_LIMIT_PER_MIN=60

# Logging
LOG_LEVEL=info
